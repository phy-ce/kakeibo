# 견본 파일입니다. 앱은 이 파일을 읽지 않습니다.
# 실제 설정은 ~/.kakeibo/.env (Windows: %USERPROFILE%\.kakeibo\.env) 에 넣으세요.
# 이 파일에는 진짜 키를 적지 마세요 (git 에 올라갑니다).

# Gemini API 키 (무료 등급) — 영수증 OCR / 메일 분석에 필요. 발급: https://aistudio.google.com/app/apikey
# 비어 있으면 첫 실행 때 콘솔에서 물어보고 자동 저장합니다.
GEMINI_API_KEY=

# (선택) 유료 Gemini API 키 — 무료 키가 한도(429)에 걸리면 이 키로 넘어갑니다.
# 결제를 연결한 "별도" Google Cloud 프로젝트에서 발급하세요. 무료 키의 프로젝트에
# 결제를 연결하면 그 키도 유료가 되어 무료 한도가 사라집니다.
# GEMINI_API_KEY_PAID=

# Flask 세션 서명 키 — 비워두면 첫 실행 때 자동 생성됩니다.
FLASK_SECRET_KEY=

# 서버 포트 (기본 5000). 다른 인스턴스와 동시 운영할 때 변경.
FLASK_PORT=5000

# (선택) 기본 Gemini 모델 ID — 설정 페이지에서 고른 모델이 우선합니다.
# GEMINI_MODEL=gemini-3.7-flash
